rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado() &&
        get(/databases/$(database)/documents/vv_usuarios/$(request.auth.uid)).data.role == "admin";
    }

    // ── Usuários do sistema ──────────────────────────────────
    match /vv_usuarios/{uid} {
      allow read:   if autenticado() && (request.auth.uid == uid || ehAdmin());
      // O primeiro administrador é criado manualmente pelo Firebase Console.
      // Nenhum usuário pode criar o próprio perfil ou se tornar administrador.
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (
        autenticado() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ultimoLoginEm"])
      );
    }

    // ── Produtos / Estoque ───────────────────────────────────
    match /vv_produtos/{id} {
      allow read:   if autenticado();
      allow write:  if autenticado();
    }

    // ── Clientes ─────────────────────────────────────────────
    match /vv_clientes/{id} {
      allow read, write: if ehAdmin();
    }

    // ── Promissórias ─────────────────────────────────────────
    match /prom_clientes/{id} {
      allow read, write: if ehAdmin();
    }
    match /prom_compras/{id} {
      allow read, write: if ehAdmin();
    }
    match /prom_pagamentos/{id} {
      allow read, write: if ehAdmin();
    }

    // ── Vendas ───────────────────────────────────────────────
    match /vv_vendas/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update: if autenticado();
      allow delete: if ehAdmin();
    }

    match /vv_venda_itens/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow delete: if ehAdmin();
    }

    // ── Compras (Fornecedores) ────────────────────────────────
    match /vv_compras_fornec/{id} {
      allow read, write: if ehAdmin();
    }

    // ── Despesas ─────────────────────────────────────────────
    match /vv_despesas/{id} {
      allow read, write: if ehAdmin();
    }

    // ── Histórico de Estoque ─────────────────────────────────
    match /vv_estoque_historico/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if ehAdmin();
    }

    // ── Histórico de Custo / Margem ──────────────────────────
    match /vv_custo_historico/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if ehAdmin();
    }

    // ── Caixa ────────────────────────────────────────────────
    match /vv_caixa/{id} {
      allow read, write: if ehAdmin();
    }

    // ── Sessões de Caixa (abertura/fechamento/sangria) ───────
    match /vv_caixa_sessoes/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update: if autenticado();
      allow delete: if ehAdmin();
    }
  }
}
