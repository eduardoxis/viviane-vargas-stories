rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function perfilAtual() {
      return get(/databases/$(database)/documents/vv_usuarios/$(request.auth.uid)).data;
    }
    function ehAdmin() {
      return autenticado() && (perfilAtual().role == "admin" ||
        (perfilAtual().roles is list && perfilAtual().roles.hasAny(["admin"])));
    }
    function ehOperadorCaixa() {
      return autenticado() && (perfilAtual().role == "operador_caixa" ||
        (perfilAtual().roles is list && perfilAtual().roles.hasAny(["operador_caixa"])));
    }
    function podeOperarCaixa() { return ehAdmin() || ehOperadorCaixa(); }

    // Usuários e acesso
    match /vv_usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || ehAdmin());
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (autenticado() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ultimoLoginEm"]));
    }

    // Produtos: operador consulta e dá baixa somente no estoque.
    match /vv_produtos/{id} {
      allow read: if autenticado();
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (ehOperadorCaixa() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estoque"]));
    }

    // Cliente e dívida de vendas fiadas.
    match /prom_clientes/{id} {
      allow read, create: if podeOperarCaixa();
      allow update, delete: if ehAdmin();
    }
    match /prom_compras/{id} {
      allow read: if ehAdmin();
      allow create: if podeOperarCaixa();
      allow update, delete: if ehAdmin();
    }

    // Venda, desconto/acréscimo registrado na venda e baixa de estoque.
    match /vv_vendas/{id} {
      allow read: if podeOperarCaixa();
      allow create: if podeOperarCaixa() && request.resource.data.operadorId == request.auth.uid;
      allow update, delete: if ehAdmin();
    }

    // Contador transacional que entrega uma numeração única para cada venda.
    match /vv_contadores/{id} {
      allow read, create, update: if podeOperarCaixa();
      allow delete: if ehAdmin();
    }
    match /vv_venda_itens/{id} {
      allow read, create: if podeOperarCaixa();
      allow update, delete: if ehAdmin();
    }
    match /vv_estoque_historico/{id} {
      allow read, create: if podeOperarCaixa();
      allow update, delete: if ehAdmin();
    }

    // Abrir caixa, sangria, fechamento e histórico do turno.
    match /vv_caixa_sessoes/{id} {
      allow read, create, update: if podeOperarCaixa();
      allow delete: if ehAdmin();
    }

    // Módulos exclusivamente administrativos.
    match /vv_clientes/{id} { allow read, write: if ehAdmin(); }
    match /prom_pagamentos/{id} { allow read, write: if ehAdmin(); }
    match /vv_compras_fornec/{id} { allow read, write: if ehAdmin(); }
    match /vv_despesas/{id} { allow read, write: if ehAdmin(); }
    match /vv_custo_historico/{id} { allow read, write: if ehAdmin(); }
    match /vv_caixa/{id} { allow read, write: if ehAdmin(); }
  }
}
